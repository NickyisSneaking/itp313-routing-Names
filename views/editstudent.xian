<h2>Edit student</h2>
<form method="post" action="/students/update/{{data.id}}">
  <input type="text" name="name" placeholder="name" value="{{data.name}}"><br>
  <input type="text" name="age" placeholder="age" value="{{data.age}}"><br>
  <input type="text" name="club" placeholder="club" value="{{data.club}}"><br>
  <input type="text" name="school" placeholder="school" value="{{data.school}}"><br>
  <input type="text" name="role" placeholder="role" value="{{data.role}}"><br>
  <input type="submit">
</form>
<a href="/students/list">Back to list</a>