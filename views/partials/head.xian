<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --sidebar:188px;
  --bg:#f2f0eb;
  --surface:#fff;
  --sb:#16213e;
  --t1:#0d0d1a;--t2:#5a5a72;--t3:#9898b0;
  --bdr:rgba(0,0,0,.07);--bdr2:rgba(0,0,0,.13);
  --blue:#2563eb;--green:#059669;--amber:#d97706;--red:#dc2626;--purple:#7c3aed;--teal:#0891b2;
  --bg-blue:#eff6ff;--bg-green:#ecfdf5;--bg-amber:#fffbeb;--bg-red:#fef2f2;--bg-purple:#f5f3ff;
  --r:8px;--rs:5px;
}
html,body{height:100%;overflow:hidden}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--t1);font-size:12px;display:flex;height:100vh}

/* SIDEBAR */
.sb{width:var(--sidebar);min-width:var(--sidebar);background:var(--sb);display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;padding-bottom:14px}
.sb::-webkit-scrollbar{width:3px}.sb::-webkit-scrollbar-thumb{background:#2a2a5a;border-radius:3px}
.logo{display:flex;align-items:center;gap:9px;padding:14px 12px 12px;border-bottom:1px solid rgba(255,255,255,.06);margin-bottom:10px}
.logo-ic{width:31px;height:31px;border-radius:7px;background:linear-gradient(135deg,#2563eb,#7c3aed);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px;color:#fff;flex-shrink:0}
.logo-t{font-size:11px;font-weight:600;color:#e8e8f4;line-height:1.3}
.logo-s{font-size:8px;color:#6666aa;letter-spacing:.09em;text-transform:uppercase}
.ss{padding:0 10px;margin-bottom:11px}
.ss-lbl{font-size:8px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#5555aa;padding:0 3px;margin-bottom:5px}
.sc{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:var(--rs);padding:6px 9px;margin-bottom:4px;cursor:pointer;transition:background .15s}
.sc:hover{background:rgba(255,255,255,.07)}
.sb-badge{display:flex;align-items:center;gap:3px;font-size:8px;font-weight:700;margin-bottom:2px}
.sb-desc{font-size:8px;color:#6666aa}.sb-city{font-size:9.5px;font-weight:700;margin-top:3px}
.cg{color:#34d399}.cr{color:#f87171}.ca{color:#fbbf24}.cb{color:#60a5fa}.cp{color:#a78bfa}
.strc{display:flex;align-items:flex-start;gap:7px;padding:6px 9px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:var(--rs);margin-bottom:4px;cursor:pointer;transition:background .15s}
.strc:hover{background:rgba(255,255,255,.07)}
.sdot{width:8px;height:8px;border-radius:2px;margin-top:2px;flex-shrink:0}
.st{font-size:10px;font-weight:500;color:#d0d0f0;line-height:1.3}
.sd{font-size:8px;color:#5555aa;margin-top:1px}.sc2{font-size:9px;font-weight:700;margin-top:2px}
.ebox{margin:6px 10px 0;background:linear-gradient(135deg,rgba(5,150,105,.18),rgba(5,150,105,.06));border:1px solid rgba(52,211,153,.22);border-radius:var(--r);padding:9px 11px}
.elbl{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#4488aa}
.eval{font-size:18px;font-weight:700;color:#34d399;margin:2px 0 1px;font-family:'DM Mono',monospace}
.esub{font-size:8px;color:#5566aa}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}

/* TOPBAR */
.topbar{display:grid;grid-template-columns:repeat(4,1fr);background:var(--surface);border-bottom:1px solid var(--bdr);flex-shrink:0}
.ts{padding:10px 15px;border-right:1px solid var(--bdr)}.ts:last-child{border-right:none}
.tsv{font-size:17px;font-weight:700;color:var(--t1);font-family:'DM Mono',monospace;line-height:1}
.tsl{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:var(--t3);margin-top:3px}

/* SCROLL */
.scr{flex:1;overflow-y:auto;overflow-x:hidden;padding:10px}
.scr::-webkit-scrollbar{width:4px}.scr::-webkit-scrollbar-thumb{background:#d0ccc6;border-radius:4px}

/* KPI */
.kr{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-bottom:8px}
.kc{background:var(--surface);border-radius:var(--r);border:1px solid var(--bdr);padding:9px 11px;position:relative;overflow:hidden}
.kc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.kc.b::before{background:var(--blue)}.kc.g::before{background:var(--green)}.kc.a::before{background:var(--amber)}.kc.t::before{background:var(--teal)}.kc.p::before{background:var(--purple)}
.kl{display:flex;justify-content:space-between;align-items:center;font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:var(--t3);margin-bottom:5px}
.kv{font-size:17px;font-weight:700;font-family:'DM Mono',monospace;line-height:1;margin-bottom:3px}
.kv.vb{color:var(--blue)}.kv.vg{color:var(--green)}.kv.va{color:var(--amber)}
.ks{font-size:8px;color:var(--t3)}
.kb{display:inline-flex;align-items:center;gap:2px;font-size:8px;font-weight:700;margin-top:4px;padding:2px 6px;border-radius:4px}
.kb.bg{background:var(--bg-green);color:var(--green)}.kb.bb{background:var(--bg-blue);color:var(--blue)}.kb.ba{background:var(--bg-amber);color:var(--amber)}

/* CARD */
.card{background:var(--surface);border-radius:var(--r);border:1px solid var(--bdr);padding:10px 12px}
.ch{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1px}
.ct{font-size:10px;font-weight:600;color:var(--t1);line-height:1.3}
.cs{font-size:8px;color:var(--t3);margin-bottom:8px}
.chip{font-size:8px;font-weight:700;padding:2px 7px;border-radius:20px;border:none;font-family:'DM Sans',sans-serif;cursor:pointer;white-space:nowrap;flex-shrink:0;margin-left:6px}
.chip-bl{background:var(--bg-blue);color:var(--blue)}.chip-gr{background:var(--bg-green);color:var(--green)}
.chip-am{background:var(--bg-amber);color:var(--amber)}.chip-gy{background:#f0ede8;color:var(--t2)}

/* ROW 1 */
.r1{display:grid;grid-template-columns:1.35fr 0.9fr 0.9fr 1fr 1fr;gap:7px;margin-bottom:8px}

/* Amenity */
.am{margin-bottom:5px}
.aml{font-size:8px;color:var(--t3);margin-bottom:2px}
.ambar{height:18px;border-radius:4px;display:flex;align-items:center;padding:0 7px}
.ambar.pos{background:linear-gradient(90deg,#059669,#34d399)}.ambar.neg{background:linear-gradient(90deg,#dc2626,#f87171)}
.amtxt{font-size:8px;font-weight:700;color:#fff}
.leg{display:flex;gap:9px;margin-top:6px;flex-wrap:wrap}
.li{display:flex;align-items:center;gap:4px;font-size:8px;color:var(--t2)}
.ld{width:8px;height:8px;border-radius:2px;flex-shrink:0}

/* Donut */
.dw{display:flex;align-items:center;gap:11px;margin-top:4px}
.dsp{position:relative;width:80px;height:80px;flex-shrink:0}
.dc{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center}
.dm{font-size:11px;font-weight:700;color:var(--green);font-family:'DM Mono',monospace}
.dl{font-size:7px;color:var(--t3)}
.rg2{display:grid;grid-template-columns:1fr 1fr;gap:5px;flex:1}
.rc{background:#f8f6f2;border-radius:var(--rs);padding:7px 8px;text-align:center}
.rv{font-size:12px;font-weight:700;font-family:'DM Mono',monospace}
.rv.rg{color:var(--green)}.rv.rr{color:var(--red)}
.rl{font-size:7.5px;color:var(--t3);margin-top:2px}

/* ROW 2 */
.r2{display:grid;grid-template-columns:2.1fr 1fr 1fr;gap:7px}

/* Table */
table.sig{width:100%;border-collapse:collapse}
table.sig thead th{font-size:7.5px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--t3);padding:4px 5px;text-align:left;border-bottom:1px solid var(--bdr2)}
table.sig tbody tr{border-bottom:1px solid var(--bdr);transition:background .1s}
table.sig tbody tr:hover{background:#faf9f7}
table.sig tbody td{padding:5px 5px;font-size:9px;color:var(--t1);vertical-align:middle}
.tn{font-size:8px;color:var(--t3);font-family:'DM Mono',monospace}
.tag{display:inline-flex;align-items:center;font-size:7.5px;font-weight:700;padding:2px 6px;border-radius:20px;white-space:nowrap}
.tbl{background:var(--bg-blue);color:var(--blue)}.tam{background:var(--bg-amber);color:var(--amber)}
.tgr{background:var(--bg-green);color:var(--green)}.tpu{background:var(--bg-purple);color:var(--purple)}.trd{background:var(--bg-red);color:var(--red)}
.lm{font-size:9px;font-weight:600;color:var(--t1)}.ls{font-size:7.5px;color:var(--t3);margin-top:1px}
.pv{font-weight:700;font-family:'DM Mono',monospace;font-size:9px}
.cw{min-width:54px}.cbar{height:4px;border-radius:2px;background:#e8e4de;overflow:hidden}
.cf{height:100%;border-radius:2px}.cf.cg{background:var(--green)}.cf.ca{background:var(--amber)}
.cp2{font-size:7.5px;color:var(--t3);margin-top:1px;font-family:'DM Mono',monospace}

/* Metrics */
.mr{display:flex;align-items:center;gap:7px;margin-bottom:5px}
.ml{font-size:8.5px;color:var(--t2);width:72px;flex-shrink:0}
.mb{flex:1;height:5px;background:#ede9e3;border-radius:3px;overflow:hidden}
.mf{height:100%;border-radius:3px}
.mv{font-size:9px;font-weight:700;font-family:'DM Mono',monospace;width:40px;text-align:right;color:var(--t1)}
.vb2{margin-top:10px;padding-top:8px;border-top:1px solid var(--bdr)}
.vl{font-size:7.5px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--t3);margin-bottom:5px}
.vr{display:flex;align-items:center;gap:7px;margin-bottom:4px}
.vn{font-size:8px;color:var(--t3);width:42px}
.vbar{flex:1;height:4px;border-radius:2px}
.vv{font-size:8.5px;font-weight:700;font-family:'DM Mono',monospace;width:34px;text-align:right}
.cp3{display:flex;justify-content:space-between;margin-top:6px}
.cl{font-size:7px;text-transform:uppercase;letter-spacing:.08em;color:var(--t3)}
.cn{font-size:12px;font-weight:700}

/* Best yield */
.bybox{margin-top:8px;background:linear-gradient(135deg,var(--bg-green),rgba(5,150,105,.04));border:1px solid rgba(5,150,105,.18);border-radius:var(--rs);padding:7px 10px;display:flex;justify-content:space-between;align-items:center}
.byl{font-size:7px;text-transform:uppercase;letter-spacing:.09em;color:var(--t3)}
.byc{font-size:13px;font-weight:700;color:var(--green)}
.bys{font-size:7.5px;color:var(--t3)}
.byy{font-size:16px;font-weight:700;color:var(--green);font-family:'DM Mono',monospace}

.cw2{position:relative;width:100%}

@keyframes fu{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.kc{animation:fu .35s ease both}
.kc:nth-child(1){animation-delay:.04s}.kc:nth-child(2){animation-delay:.08s}
.kc:nth-child(3){animation-delay:.12s}.kc:nth-child(4){animation-delay:.16s}.kc:nth-child(5){animation-delay:.20s}
.card{animation:fu .4s ease both}
</style>
</head>
<body>
